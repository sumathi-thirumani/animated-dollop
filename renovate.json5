{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Repository-specific npm update rules for the Vue 3 and Vite frontend. Inherits shared update policies from the BC Gov preset.",
  "extends": [
    "github>bcgov/renovate-config#2026.8.18"
  ],
  "packageRules": [
    {
      "description": "Regenerate npm lockfiles consistently",
      "matchManagers": [
        "npm"
      ],
      "postUpdateOptions": [
        "npmInstallTwice"
      ]
    },
    {
      "description": "Vue ecosystem",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "vue",
        "vue-router",
        "pinia",
        "@vueuse/core",
        "@vue/test-utils",
        "@vue/tsconfig"
      ],
      "groupName": "Vue ecosystem",
      "groupSlug": "vue-ecosystem"
    },
    {
      "description": "Vite tooling",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "vite",
        "@vitejs/plugin-vue",
        "vite-plugin-vue-devtools"
      ],
      "groupName": "Vite tooling",
      "groupSlug": "vite"
    },
    {
      "description": "Vuetify",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "vuetify",
        "vite-plugin-vuetify"
      ],
      "groupName": "Vuetify",
      "groupSlug": "vuetify"
    },
    {
      "description": "FullCalendar",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@fullcalendar/core",
        "@fullcalendar/vue3"
      ],
      "groupName": "FullCalendar",
      "groupSlug": "fullcalendar"
    },
    {
      "description": "TypeScript tooling",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript",
        "@typescript/native",
        "vue-tsc"
      ],
      "groupName": "TypeScript tooling",
      "groupSlug": "typescript"
    },
    {
      "description": "ESLint and Oxlint tooling",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "eslint",
        "eslint-config-prettier",
        "eslint-plugin-vue",
        "eslint-plugin-oxlint",
        "eslint-plugin-playwright",
        "@vue/eslint-config-typescript",
        "@vitest/eslint-plugin",
        "oxlint"
      ],
      "groupName": "ESLint and Oxlint tooling",
      "groupSlug": "lint-tooling"
    },
    {
      "description": "Vitest tooling",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "vitest",
        "happy-dom"
      ],
      "groupName": "Vitest tooling",
      "groupSlug": "vitest"
    },
    {
      "description": "Luxon",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "luxon",
        "@types/luxon",
        "@date-io/luxon"
      ],
      "groupName": "Luxon",
      "groupSlug": "luxon"
    },
    {
      "description": "Node.js types and TypeScript configuration",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@types/node",
        "@tsconfig/node24"
      ],
      "groupName": "Node.js types and TypeScript configuration",
      "groupSlug": "node-types"
    }
  ]
}
